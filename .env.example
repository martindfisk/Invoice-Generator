# Copy to .env (git-ignored). Never commit real keys.
# .env is only the bootstrap default: anything saved in the app's settings dialog is written
# to backend/.uapi-settings.json (git-ignored, chmod 600) and takes precedence over these
# values — including across backend restarts. Delete that file to fall back to .env.

# fiskaly Unified API
# The environment (test/live host) saved in the settings dialog wins over this URL.
UAPI_BASE_URL=https://test.api.fiskaly.com
# Defaults to spec/version.txt; the API accepts only the exact current CalVer.
#UAPI_API_VERSION=2026-06-01
# live | mock  (mock replays backend/fixtures/uapi; no credentials needed)
UAPI_MODE=mock

# Unit-level API key from hub.fiskaly.com (the key decides which organisation you act as)
UAPI_API_KEY=
UAPI_API_SECRET=
# Per-country e-invoice system + taxpayer ids; guided provisioning in the Test runner
# fills these into backend/.uapi-settings.json automatically.
UAPI_SYSTEM_ID_IT=
UAPI_TAXPAYER_ID_IT=
UAPI_SYSTEM_ID_BE=
UAPI_TAXPAYER_ID_BE=
UAPI_SYSTEM_ID_DE=
UAPI_TAXPAYER_ID_DE=

# Backend
# Where UI-saved settings persist (default: backend/.uapi-settings.json)
#UAPI_SETTINGS_FILE=
# Vendored XSD/XSLT directory (default: <repo>/vendor, filled by make schemas)
#VENDOR_DIR=
# Optional roots of local standards bundles (os.pathsep-separated, i.e. ':' on macOS/Linux).
# tools/fetch_assets.py joins each root with the localSubdirs in tools/rulesets.json and copies
# a file only when it matches the pinned sha256; unset means download everything.
#STANDARDS_DIRS=
CORS_ORIGINS=http://localhost:5173
RECORDER_CAPACITY=500
POLL_INTERVAL_S=2
POLL_TIMEOUT_S=60
LOG_LEVEL=INFO
