# Copy to .env (git-ignored). Never commit real keys.
# These values are the fallback defaults only: PUT /api/settings (the UI settings dialog) can
# override the environment, credentials, system ids and recipients for the running backend
# session. Session values live in memory, are never written back here and are lost on restart.

# fiskaly Unified API
UAPI_BASE_URL=https://test.api.fiskaly.com
# Defaults to spec/version.txt; the API accepts only the exact current CalVer.
#UAPI_API_VERSION=2026-06-01
# live | mock  (mock replays backend/fixtures/uapi; no credentials needed)
UAPI_MODE=mock
# Record live responses (masked) as fixtures while in live mode
UAPI_RECORD=0
# Allow X-Demo-Mode request header to override UAPI_MODE (tests only)
ALLOW_MODE_OVERRIDE=0
# live | simulated  (simulated feeds the Seller's compliance artifact into the Buyer inbox)
RECEPTION_MODE=simulated

# Seller organisation (Unit-level TEST key from hub.fiskaly.com)
SELLER_API_KEY=
SELLER_API_SECRET=
SELLER_SYSTEM_ID_IT=
SELLER_TAXPAYER_ID_IT=
SELLER_SYSTEM_ID_BE=
SELLER_TAXPAYER_ID_BE=

# Buyer organisation (Unit-level TEST key)
BUYER_API_KEY=
BUYER_API_SECRET=
BUYER_SYSTEM_ID_IT=
BUYER_TAXPAYER_ID_IT=
BUYER_SYSTEM_ID_BE=
BUYER_TAXPAYER_ID_BE=
# Recipient identifiers used by the presets
BUYER_SDI_DESTINATION_CODE=
BUYER_PEPPOL_ID=

# Backend
# Vendored XSD/XSLT directory (default: <repo>/vendor, filled by make schemas)
#VENDOR_DIR=
CORS_ORIGINS=http://localhost:5173
RECORDER_CAPACITY=500
POLL_INTERVAL_S=2
POLL_TIMEOUT_S=60
LOG_LEVEL=INFO
