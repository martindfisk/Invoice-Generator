# Validation assets (XSDs, Schematron sources) are git-ignored and licence-constrained
# (see vendor/SOURCES.md): they are fetched sha256-pinned inside the build, on the machine
# that builds the image, never shipped through git.
FROM python:3.13-slim AS assets
COPY tools/ /tools/
RUN VENDOR_DIR=/vendor python /tools/fetch_assets.py

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --create-home app
WORKDIR /srv
COPY backend/ /srv/backend/
COPY spec/ /srv/spec/
COPY --from=assets /vendor /srv/vendor
ENV VENDOR_DIR=/srv/vendor
RUN pip install --no-cache-dir /srv/backend
# UI-saved settings persist here (docker-compose mounts a volume over it); must be writable
# by the non-root user or every settings save fails with EACCES.
RUN mkdir -p /data && chown app /data
USER app
WORKDIR /srv/backend
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
